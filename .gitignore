node_modules/
out/
dist/

# Intermediate output of `zig rc` when building the native splash stub. The
# linked result, build/bin/splash.exe, IS committed on purpose so that
# `pnpm dist` works on a machine without a compiler.
native/splash/*.res
*.log
.DS_Store
*.tsbuildinfo
.claude/
claude*
# Local env files hold the CurseForge API key (MAIN_VITE_CURSEFORGE_API_KEY).
# It is baked into the build by electron-vite and must never be committed.
.env
.env.*
